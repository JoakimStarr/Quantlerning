# Quantlerning 配置（复制为 backend/.env 后按需修改）

# 只读连接 quantlab 库
POSTGRES_USER=quantlab
POSTGRES_PASSWORD=quantlab
POSTGRES_DB=quantlab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# AI 追问（opencodezen，OpenAI 兼容接口；key 只存后端，不暴露前端）
# 填你的 opencodezen API key；留空时课程页「AI 追问」会提示未配置
OPENCODEZEN_API_KEY=
# OPENCODEZEN_BASE_URL=https://opencode.ai/zen/v1
# OPENCODEZEN_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
