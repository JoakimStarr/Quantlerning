# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# 环境变量（含 API key，切勿提交）
.env
.env.*
!*.env.example

# 运行时 AI 配置（含 API key，切勿提交）
ai_settings.json

# Node / 前端
node_modules/
dist/
*.local

# vite.config.ts 的 tsc 编译产物（vite 会优先加载 .js，误留会导致配置不生效）
vite.config.js
vite.config.d.ts

# TypeScript 构建缓存
*.tsbuildinfo

# 日志与临时文件
*.log
/tmp/
.DS_Store
*.swp

# start.sh 记录的运行时端口/进程状态（含 mode / port / pid）
.runtime_ports
